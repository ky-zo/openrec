{
  "name": "openrec-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:bootstrap:local": "wrangler d1 execute openrec --local --file=schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply openrec --local",
    "db:migrate": "wrangler d1 migrations apply openrec --remote",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.120.1"
  }
}
